# Dev-only image: hot-reloads on source changes via air, and bundles Pandoc +
# a PDF engine so import/export work out of the box in docker-compose without
# needing anything installed on the host. Not meant for production (see the
# ARM/Oracle-VM deploy notes in README.md instead).
FROM golang:1.25-alpine

RUN apk add --no-cache \
        pandoc \
        curl \
        ca-certificates \
        xz

# Typst as the PDF engine Pandoc shells out to (PANDOC_PDF_ENGINE) — a single
# static binary, avoiding a multi-GB TeX Live install just for local PDF
# export in dev. Same engine already validated to work in this project.
ARG TYPST_VERSION=v0.15.1
RUN curl -fsSL "https://github.com/typst/typst/releases/download/${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz" -o /tmp/typst.tar.xz \
    && tar -xJf /tmp/typst.tar.xz -C /tmp \
    && mv /tmp/typst-x86_64-unknown-linux-musl/typst /usr/local/bin/typst \
    && rm -rf /tmp/typst*

RUN go install github.com/air-verse/air@v1.62.0

WORKDIR /app

# Cached separately from the rest of the source so `go mod download` only
# reruns when dependencies actually change.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
