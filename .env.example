# Root env file, loaded by docker-compose.dev.yml (via env_file) for both the
# backend and frontend containers — see docker-compose.dev.yml for the few
# values that must differ inside the container network. Copy to .env in this
# same directory and adjust as needed. Never commit a real .env.
#
# The backend (backend/cmd/api/main.go) loads this via godotenv; the
# frontend (frontend/next.config.ts) loads it via @next/env. Both expect it
# at the repo root, not inside backend/ or frontend/.

# --- Backend -----------------------------------------------------------

PORT=8080

# Postgres connection string. Local dev: hostname `postgres` is the
# docker-compose service name — only reachable from inside that network
# (the backend and goose migrations both run in containers, never natively
# on the host). Production: the Neon connection string from your project's
# dashboard.
DATABASE_URL=postgres://kenoma:kenoma@postgres:5432/kenoma?sslmode=disable

# HMAC secrets for signing access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret

# Token lifetimes (Go duration syntax). Defaults shown are also the code's
# fallback if these are omitted.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
INVITATION_TTL=168h
PASSWORD_RESET_TTL=1h

# Frontend origin: used for CORS and for building invitation accept-links and
# password-reset links in emails.
FRONTEND_URL=http://localhost:3000

# false only for local plain-http dev; the refresh-token cookie is
# SameSite=None which browsers require Secure for outside of localhost.
COOKIE_SECURE=false

# Path to the pandoc binary. "pandoc" if it's on PATH.
PANDOC_PATH=pandoc

# Passed to `pandoc --pdf-engine`. Pandoc's own default (pdflatex) is not
# installed by any of the base images/OSes we target, so this must point to
# something real for PDF export to work: tectonic (recommended for Linux ARM
# — single static binary, no LaTeX install), wkhtmltopdf, weasyprint, or
# typst are all valid choices pandoc supports.
PANDOC_PDF_ENGINE=tectonic

# --- Frontend ------------------------------------------------------------

# URL of the Go backend's API, including the /api/v1 prefix. Public
# (prefixed NEXT_PUBLIC_) because the browser calls the API directly.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
