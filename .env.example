# Root env file, loaded by docker-compose.dev.yml (via env_file) for both the
# backend and frontend containers — see docker-compose.dev.yml for the few
# values that must differ inside the container network. Copy to .env in this
# same directory and adjust as needed. Never commit a real .env.
#
# The backend (backend/cmd/api/main.go) loads this via godotenv; the
# frontend (frontend/next.config.ts) loads it via @next/env. Both expect it
# at the repo root, not inside backend/ or frontend/.

# --- Backend -----------------------------------------------------------

PORT=8080

# Postgres connection string. Local dev: hostname `postgres` is the
# docker-compose service name — only reachable from inside that network
# (the backend and goose migrations both run in containers, never natively
# on the host). Production: the Neon connection string from your project's
# dashboard.
DATABASE_URL=postgres://kenoma:kenoma@postgres:5432/kenoma?sslmode=disable

# HMAC secret for signing access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Refresh tokens need no secret: they are opaque random bytes validated by a
# database lookup, not by a signature.
JWT_ACCESS_SECRET=changeme-access-secret

# Token lifetimes (Go duration syntax). Defaults shown are also the code's
# fallback if these are omitted.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
INVITATION_TTL=168h
PASSWORD_RESET_TTL=1h

# Per-IP rate limit on the public auth endpoints (register, login, refresh,
# logout, password reset). AUTH_RATE_LIMIT is the max requests allowed within
# AUTH_RATE_WINDOW; set AUTH_RATE_LIMIT=0 to disable the limiter. TRUST_PROXY
# must be true when a reverse proxy sits in front and sets X-Forwarded-For,
# otherwise every caller looks like the proxy's own address and the whole site
# shares one bucket.
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW=1m
TRUST_PROXY=false

# Frontend origin: used for CORS and for building invitation accept-links and
# password-reset links in emails.
FRONTEND_URL=http://localhost:3000

# false only for local plain-http dev; true in production so the refresh-token
# cookie is never sent over plain http. The cookie is SameSite=Lax, which works
# because the site (kenoma.com) and the API (api.kenoma.com) share a
# registrable domain and are therefore same-site.
COOKIE_SECURE=false

# Resend API key for transactional email (password reset). Leave empty in
# local dev to use a no-op sender that logs the email instead of sending it.
RESEND_API_KEY=

# Sender address for transactional email. Resend's shared sandbox address
# until a domain is verified in the Resend dashboard, then swap this to a
# verified address — no code change needed either way.
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Path to the pandoc binary. "pandoc" if it's on PATH.
PANDOC_PATH=pandoc

# Passed to `pandoc --pdf-engine`. Pandoc's own default (pdflatex) is not
# installed by any of the base images/OSes we target, so this must point to
# something real for PDF export to work. The dev image (backend/Dockerfile.dev)
# bakes in typst, so match it here: tectonic (recommended for Linux ARM —
# single static binary, no LaTeX install), wkhtmltopdf, weasyprint, or typst
# are all valid choices pandoc supports.
PANDOC_PDF_ENGINE=typst

# --- Frontend ------------------------------------------------------------

# URL of the Go backend's API, including the /api/v1 prefix. Public
# (prefixed NEXT_PUBLIC_) because the browser calls the API directly.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
